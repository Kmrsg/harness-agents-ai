{
  "name": "agent-harness-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-harness": "bin/agent-harness.mjs"
  },
  "files": [
    "bin",
    "dist",
    "agents",
    "knowledge",
    "skills",
    "examples",
    "docs",
    "README.md",
    "AGENT_HARNESS_MVP.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "harness": "npm run build && node dist/src/cli/main.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "test": "npm run build && node --test dist/tests/*/*.test.js",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write src scripts tests bin \"*.json\"",
    "format:check": "prettier --check src scripts tests bin \"*.json\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "3.6.2",
    "typescript": "5.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
